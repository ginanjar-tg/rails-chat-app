<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-white/10 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/20 overflow-hidden">
    <!-- Header -->
    <div class="bg-gradient-to-r from-purple-600 to-pink-600 px-6 py-8 text-center">
      <h1 class="text-3xl font-bold text-white mb-2">💬 Rails Chat</h1>
      <p class="text-white/80">Enter your username to join the chat</p>
    </div>

    <!-- Form -->
    <div class="p-6">
      <% if flash[:alert] %>
        <div class="mb-4 p-3 bg-red-500/20 border border-red-500/50 rounded-lg text-red-200 text-sm">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: sessions_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <label for="username" class="block text-sm font-medium text-white/80 mb-2">Username</label>
          <%= text_field_tag :username,
              nil,
              placeholder: "Enter your username",
              autofocus: true,
              required: true,
              class: "w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" %>
        </div>

        <%= submit_tag "Join Chat",
            class: "w-full px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold rounded-xl hover:from-purple-700 hover:to-pink-700 focus:outline-none focus:ring-2 focus:ring-purple-500 transition-all cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
