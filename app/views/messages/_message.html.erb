<div id="<%= dom_id(message) %>" class="flex items-start gap-3 animate-fade-in">
  <div class="flex-shrink-0 w-9 h-9 rounded-full bg-neutral-600 flex items-center justify-center text-white font-medium text-sm">
    <%= message.username[0].upcase %>
  </div>
  <div class="flex-1 min-w-0">
    <div class="flex items-baseline gap-2 mb-0.5">
      <span class="font-medium text-white text-sm"><%= message.username %></span>
      <span class="text-xs text-neutral-500"><%= message.created_at.strftime("%H:%M") %></span>
    </div>
    <p class="text-neutral-300 text-sm break-words"><%= message.content %></p>
  </div>
</div>
