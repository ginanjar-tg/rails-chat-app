<%= turbo_stream_from "chatroom" %>

<div class="min-h-screen bg-neutral-900 flex items-center justify-center p-4">
  <div class="w-full max-w-2xl bg-neutral-800 rounded-lg shadow-lg overflow-hidden">
    <!-- Header -->
    <div class="bg-neutral-700 px-6 py-4 flex items-center justify-between">
      <h1 class="text-lg font-semibold text-white">Rails Chat</h1>
      <span class="text-sm text-neutral-400">Logged in as <span class="text-white font-medium"><%= session[:username] %></span></span>
    </div>

    <!-- Messages Container -->
    <div id="messages" class="h-96 overflow-y-auto p-4 space-y-3 scroll-smooth">
      <% @messages.each do |message| %>
        <%= render message %>
      <% end %>
    </div>

    <!-- Message Form -->
    <div class="border-t border-neutral-700 p-4 bg-neutral-800">
      <%= form_with model: @message, class: "flex gap-3" do |f| %>
        <%= f.text_field :content,
            placeholder: "Type your message...",
            autocomplete: "off",
            autofocus: true,
            class: "flex-1 px-4 py-3 bg-neutral-700 border border-neutral-600 rounded text-white placeholder-neutral-500 focus:outline-none focus:ring-2 focus:ring-neutral-500 focus:border-transparent transition-colors" %>
        <%= f.submit "Send",
            class: "px-6 py-3 bg-neutral-600 text-white font-medium rounded hover:bg-neutral-500 focus:outline-none focus:ring-2 focus:ring-neutral-500 transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>

<script>
  // Auto-scroll to bottom when new messages arrive
  const messagesContainer = document.getElementById('messages');
  const observer = new MutationObserver(() => {
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  });
  observer.observe(messagesContainer, { childList: true });
  messagesContainer.scrollTop = messagesContainer.scrollHeight;
</script>
