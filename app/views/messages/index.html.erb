<%= turbo_stream_from "chatroom" %>

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 flex items-center justify-center p-4">
  <div class="w-full max-w-2xl bg-white/10 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/20 overflow-hidden">
    <!-- Header -->
    <div class="bg-gradient-to-r from-purple-600 to-pink-600 px-6 py-4">
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-bold text-white">💬 Rails Chat</h1>
        <span class="text-sm text-white/80">Logged in as <strong><%= session[:username] %></strong></span>
      </div>
    </div>

    <!-- Messages Container -->
    <div id="messages" class="h-96 overflow-y-auto p-4 space-y-3 scroll-smooth">
      <% @messages.each do |message| %>
        <%= render message %>
      <% end %>
    </div>

    <!-- Message Form -->
    <div class="border-t border-white/20 p-4 bg-white/5">
      <%= form_with model: @message, class: "flex gap-3" do |f| %>
        <%= f.text_field :content,
            placeholder: "Type your message...",
            autocomplete: "off",
            autofocus: true,
            class: "flex-1 px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" %>
        <%= f.submit "Send",
            class: "px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold rounded-xl hover:from-purple-700 hover:to-pink-700 focus:outline-none focus:ring-2 focus:ring-purple-500 transition-all cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>

<script>
  // Auto-scroll to bottom when new messages arrive
  const messagesContainer = document.getElementById('messages');
  const observer = new MutationObserver(() => {
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  });
  observer.observe(messagesContainer, { childList: true });
  messagesContainer.scrollTop = messagesContainer.scrollHeight;
</script>
