<div class="min-h-screen bg-neutral-900 flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-neutral-800 rounded-lg shadow-lg overflow-hidden">
    <!-- Header -->
    <div class="bg-neutral-700 px-6 py-6 text-center">
      <h1 class="text-2xl font-semibold text-white">Rails Chat</h1>
      <p class="text-neutral-400 text-sm mt-1">Enter your username to join</p>
    </div>

    <!-- Form -->
    <div class="p-6">
      <% if flash[:alert] %>
        <div class="mb-4 p-3 bg-red-900/50 border border-red-700 rounded text-red-300 text-sm">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: sessions_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <label for="username" class="block text-sm font-medium text-neutral-300 mb-2">Username</label>
          <%= text_field_tag :username,
              nil,
              placeholder: "Enter your username",
              autofocus: true,
              required: true,
              class: "w-full px-4 py-3 bg-neutral-700 border border-neutral-600 rounded text-white placeholder-neutral-500 focus:outline-none focus:ring-2 focus:ring-neutral-500 focus:border-transparent transition-colors" %>
        </div>

        <%= submit_tag "Join Chat",
            class: "w-full px-6 py-3 bg-neutral-600 text-white font-medium rounded hover:bg-neutral-500 focus:outline-none focus:ring-2 focus:ring-neutral-500 transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
